generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, uuid_ossp(map: "uuid-ossp"), vector, pg_trgm]
  schemas    = ["pipeline", "public"]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Article {
  article_id                          BigInt                     @id @default(autoincrement())
  version                             String?                    @db.VarChar
  issue_id                            BigInt?
  title                               String                     @db.VarChar
  abstract                            String?                    @db.VarChar
  publication_year                    Int?
  doi                                 String?                    @db.VarChar
  primary_topic                       BigInt?
  semantic_scholar_id                 String?                    @db.VarChar
  citation_count                      BigInt?
  semantic_influential_citation_count BigInt?
  semantic_external_ids               Json?
  semantic_tldr                       String?                    @db.VarChar
  references                          Json?
  reference_count                     BigInt?
  created_at                          DateTime?                  @default(now()) @db.Timestamp(6)
  is_deleted                          Boolean?                   @default(false)
  embedding                           Unsupported("vector")?
  Issue                               Issue?                     @relation(fields: [issue_id], references: [issue_id], onDelete: NoAction, onUpdate: NoAction)
  Topic                               Topic?                     @relation(fields: [primary_topic], references: [topic_id], onDelete: NoAction, onUpdate: NoAction)
  Author_Article                      Author_Article[]
  Keyword_Article                     Keyword_Article[]
  Project_Article_Bookmark            Project_Article_Bookmark[]
  Sub_Topic                           Sub_Topic[]

  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_article_title_trgm")
  @@index([abstract(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_article_abstract_trgm")
  @@index([publication_year], map: "idx_article_pub_year")
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Author {
  author_id                 BigInt               @id @default(autoincrement())
  orcid                     String?              @unique @db.VarChar
  display_name              String?              @db.VarChar
  url_image                 String?              @db.VarChar
  openalex_id               String?              @unique @db.VarChar
  works_count               BigInt?
  cited_by_count            BigInt?
  h_index                   BigInt?
  i10_index                 BigInt?
  last_known_institution    String?              @db.VarChar
  last_known_institution_id String?              @db.VarChar
  created_at                DateTime?            @default(now()) @db.Timestamp(6)
  is_deleted                Boolean?             @default(false)
  Author_Article            Author_Article[]
  Institution_Author        Institution_Author[]

  @@schema("public")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Author_Article {
  author_id  BigInt
  article_id BigInt
  Article    Article @relation(fields: [article_id], references: [article_id], onDelete: NoAction, onUpdate: NoAction)
  Author     Author  @relation(fields: [author_id], references: [author_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([author_id, article_id])
  @@schema("public")
}

model Institution {
  institution_id     BigInt               @id @default(autoincrement())
  openalex_id        String?              @unique @db.VarChar
  display_name       String               @db.VarChar
  country_code       String?              @db.VarChar
  type               String?              @db.VarChar
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  is_deleted         Boolean?             @default(false)
  Institution_Author Institution_Author[]

  @@index([country_code, type], map: "idx_institution_country_type")
  @@schema("public")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Institution_Author {
  author_id      BigInt
  institution_id BigInt
  year           Int
  Author         Author      @relation(fields: [author_id], references: [author_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_institution_author_author")
  Institution    Institution @relation(fields: [institution_id], references: [institution_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_institution_author_institution")

  @@id([author_id, institution_id, year])
  @@index([institution_id], map: "idx_institution_author_institution")
  @@index([year], map: "idx_institution_author_year")
  @@schema("public")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Issue {
  issue_id         BigInt    @id @default(autoincrement())
  volume_id        BigInt?
  issue_number     String?   @db.VarChar
  publication_year Int?
  is_deleted       Boolean?  @default(false)
  Article          Article[]
  Volume           Volume?   @relation(fields: [volume_id], references: [volume_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Journal {
  journal_id                 BigInt                     @id @default(autoincrement())
  source_id                  String?                    @db.VarChar
  publisher_id               BigInt?
  country                    BigInt?
  region                     BigInt?
  display_name               String                     @db.VarChar
  type                       String?                    @db.VarChar
  is_open_access             Boolean?
  is_oa_diamond              Boolean?
  coverage                   String?                    @db.VarChar
  issn                       String?                    @db.VarChar
  created_at                 DateTime?                  @default(now()) @db.Timestamp(6)
  is_deleted                 Boolean?                   @default(false)
  Zone_Journal_countryToZone Zone?                      @relation("Journal_countryToZone", fields: [country], references: [zone_id], onDelete: NoAction, onUpdate: NoAction)
  Publisher                  Publisher?                 @relation(fields: [publisher_id], references: [publisher_id], onDelete: NoAction, onUpdate: NoAction)
  Zone_Journal_regionToZone  Zone?                      @relation("Journal_regionToZone", fields: [region], references: [zone_id], onDelete: NoAction, onUpdate: NoAction)
  Journal_Ranking            Journal_Ranking[]
  Journal_Subject_Category   Journal_Subject_Category[]
  Project_Journal            Project_Journal[]
  Volume                     Volume[]

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
