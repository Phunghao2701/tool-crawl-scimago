  Topic      Topic   @relation(fields: [topic_id], references: [topic_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([article_id, topic_id])
  @@schema("public")
}

model Subject_Area {
  subject_area_id  BigInt             @id @default(autoincrement())
