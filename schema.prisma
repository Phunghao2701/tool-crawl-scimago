  @@id([journal_id, subject_category_id])
  @@schema("public")
}

model Keyword {
  keyword_id      BigInt            @id @default(autoincrement())
  display_name    String?           @unique @db.VarChar
  Keyword_Article Keyword_Article[]
  Project_Keyword Project_Keyword[]

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Keyword_Article {
  keyword_id BigInt
  article_id BigInt
  score      Float?
  Article    Article @relation(fields: [article_id], references: [article_id], onDelete: NoAction, onUpdate: NoAction)
  Keyword    Keyword @relation(fields: [keyword_id], references: [keyword_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([keyword_id, article_id])
  @@schema("public")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Password_Reset_Token {
  token_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamp(6)
  used_at    DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  user       user      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([token_hash], map: "idx_prt_token_hash")
  @@index([user_id], map: "idx_prt_user_id")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Project {
  project_id               BigInt                     @id @default(autoincrement())
  user_id                  String?                    @db.Uuid
  subject_area             BigInt?
  title                    String?                    @db.VarChar
  created_at               DateTime?                  @default(now()) @db.Timestamp(6)
  status                   String?                    @default("INACTIVE") @db.VarChar(50)
  Subject_Area             Subject_Area?              @relation(fields: [subject_area], references: [subject_area_id], onDelete: NoAction, onUpdate: NoAction)
  user                     user?                      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  Project_Article_Bookmark Project_Article_Bookmark[]
  Project_Chat_Message     Project_Chat_Message[]
  Project_Journal          Project_Journal[]
  Project_Keyword          Project_Keyword[]
  Project_Member           Project_Member[]
  Subject_Category_Project Subject_Category_Project[]

  @@schema("public")
}

model Project_Article_Bookmark {
  project_id BigInt
  article_id BigInt
  user_id    String    @db.Uuid
  added_at   DateTime? @default(now()) @db.Timestamp(6)
  Article    Article   @relation(fields: [article_id], references: [article_id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Project_Article_Article")
  Project    Project   @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Project_Article_Project")
  user       user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Project_Article_User")

  @@id([project_id, article_id, user_id], map: "PK_Project_Article_Bookmark")
  @@schema("public")
}

model Project_Chat_Message {
  message_id        BigInt         @id @default(autoincrement())
  project_id        BigInt
  role              message_role
  content           String
  model             String?        @db.VarChar(100)
  prompt_tokens     Int?           @default(0)
  completion_tokens Int?           @default(0)
  total_tokens      Int?           @default(0)
  latency_ms        Int?
  status            message_status @default(COMPLETED)
  created_at        DateTime       @default(now()) @db.Timestamp(6)
  user_id           String?        @db.Uuid
  Project           Project        @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_chat_message_project")
  user              user?          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_chat_message_user")

  @@index([project_id, created_at], map: "idx_project_chat_message_project_created")
  @@schema("public")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Project_Journal {
  project_id BigInt
  journal_id BigInt
  Journal    Journal @relation(fields: [journal_id], references: [journal_id], onDelete: NoAction, onUpdate: NoAction)
  Project    Project @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([project_id, journal_id])
  @@schema("public")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Project_Keyword {
  project_id BigInt
  keyword_id BigInt
  Keyword    Keyword @relation(fields: [keyword_id], references: [keyword_id], onDelete: NoAction, onUpdate: NoAction)
  Project    Project @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([project_id, keyword_id])
  @@schema("public")
}

model Project_Member {
  project_member_id                    BigInt                @id @default(autoincrement())
  project_id                           BigInt
  user_id                              String                @db.Uuid
  role                                 project_member_role   @default(MEMBER)
  status                               project_member_status @default(INVITED)
  invited_by                           String                @db.Uuid
  invited_at                           DateTime              @default(now()) @db.Timestamp(6)
  accepted_at                          DateTime?             @db.Timestamp(6)
  removed_at                           DateTime?             @db.Timestamp(6)
  user_Project_Member_invited_byTouser user                  @relation("Project_Member_invited_byTouser", fields: [invited_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_pm_invited_by")
  Project                              Project               @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pm_project")
  user_Project_Member_user_idTouser    user                  @relation("Project_Member_user_idTouser", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pm_user")

  @@unique([project_id, user_id], map: "uq_project_member")
  @@index([project_id], map: "idx_pm_project")
  @@index([status], map: "idx_pm_status")
  @@index([user_id], map: "idx_pm_user")
  @@schema("public")
}

model Publisher {
  publisher_id BigInt    @id @default(autoincrement())
  display_name String?   @unique(map: "uq_publisher_display_name") @db.VarChar
  image_url    String?   @db.VarChar
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  is_deleted   Boolean   @default(false)
