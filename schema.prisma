  name                          String?      @db.VarChar
  type                          type_zone?
  iso_code                      String?      @db.VarChar
  source                        source_zone?
  created_at                    DateTime?    @default(now()) @db.Timestamp(6)
  Journal_Journal_countryToZone Journal[]    @relation("Journal_countryToZone")
  Journal_Journal_regionToZone  Journal[]    @relation("Journal_regionToZone")

  @@unique([name, type], map: "uq_zone_name_type")
  @@schema("public")
}

model coin_package {
  package_id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(100)
  coin_amount         BigInt
  bonus_coin          BigInt                @default(0)
  price               Decimal               @db.Decimal(18, 2)
  currency            String                @default("VND") @db.VarChar(10)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  payment_transaction payment_transaction[]

  @@schema("public")
}

model payment_transaction {
  transaction_id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String               @db.Uuid
  package_id                String?              @db.Uuid
  amount                    Decimal              @db.Decimal(18, 2)
  currency                  String               @default("VND") @db.VarChar(10)
  coin_amount               BigInt
  bonus_coin                BigInt               @default(0)
  total_coin                BigInt
  payment_method            payment_method
  payment_status            payment_status       @default(pending)
  provider_transaction_code String?              @db.VarChar(255)
  note                      String?
  created_at                DateTime             @default(now()) @db.Timestamp(6)
  paid_at                   DateTime?            @db.Timestamp(6)
  coin_package              coin_package?        @relation(fields: [package_id], references: [package_id], onUpdate: NoAction, map: "fk_payment_package")
  user                      user                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_user")
  wallet_transaction        wallet_transaction[]

  @@index([payment_status], map: "idx_payment_status")
  @@index([user_id], map: "idx_payment_user")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model system_log {
  log_id       BigInt        @id @default(autoincrement())
  user_id      String?       @db.Uuid
  user_role    role_account?
  action       log_action
  level        log_level     @default(INFO)
  source       log_source    @default(API)
  entity_table String?       @db.VarChar(100)
  entity_id    String?       @db.VarChar(64)
  message      String?
  old_data     Json?
  new_data     Json?
  metadata     Json?
  created_at   DateTime      @default(now()) @db.Timestamp(6)
  user         user?         @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "fk_system_log_user")

  @@index([action], map: "idx_system_log_action")
  @@index([created_at], map: "idx_system_log_created_at")
  @@index([entity_table, entity_id], map: "idx_system_log_entity")
  @@index([user_id], map: "idx_system_log_user_id")
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user {
  user_id                                        String                     @id @db.Uuid
  email                                          String                     @unique @db.VarChar
  password                                       String?                    @db.VarChar
  type                                           auth_provider?
  status                                         status_account?
  role                                           role_account?
  last_name                                      String?                    @db.VarChar
  first_name                                     String?                    @db.VarChar
  url_image                                      String?                    @db.VarChar
  date_of_birth                                  DateTime?                  @db.Date
  gender                                         Boolean?
  Password_Reset_Token                           Password_Reset_Token[]
  Project                                        Project[]
  Project_Article_Bookmark                       Project_Article_Bookmark[]
  Project_Chat_Message                           Project_Chat_Message[]
  Project_Member_Project_Member_invited_byTouser Project_Member[]           @relation("Project_Member_invited_byTouser")
  Project_Member_Project_Member_user_idTouser    Project_Member[]           @relation("Project_Member_user_idTouser")
  payment_transaction                            payment_transaction[]
  system_log                                     system_log[]
  wallet                                         wallet?
  wallet_transaction                             wallet_transaction[]

  @@schema("public")
}

model wallet {
  wallet_id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String               @unique @db.Uuid
  balance            BigInt               @default(0)
  total_deposit      BigInt               @default(0)
  total_spent        BigInt               @default(0)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  user               user                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wallet_user")
  wallet_transaction wallet_transaction[]

  @@index([user_id], map: "idx_wallet_user")
  @@schema("public")
}

model wallet_transaction {
  wallet_transaction_id  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_id              String                  @db.Uuid
  user_id                String                  @db.Uuid
  type                   wallet_transaction_type
  amount                 BigInt
  balance_before         BigInt
  balance_after          BigInt
  payment_transaction_id String?                 @db.Uuid
  description            String?
  created_at             DateTime                @default(now()) @db.Timestamp(6)
  payment_transaction    payment_transaction?    @relation(fields: [payment_transaction_id], references: [transaction_id], onUpdate: NoAction, map: "fk_wallet_transaction_payment")
  user                   user                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wallet_transaction_user")
  wallet                 wallet                  @relation(fields: [wallet_id], references: [wallet_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wallet_transaction_wallet")

  @@index([created_at(sort: Desc)], map: "idx_wallet_transaction_created")
  @@index([user_id], map: "idx_wallet_transaction_user")
  @@index([wallet_id], map: "idx_wallet_transaction_wallet")
  @@schema("public")
}

