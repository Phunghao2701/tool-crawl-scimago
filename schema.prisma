  Journal_Subject_Category         Journal_Subject_Category[]
  Subject_Area                     Subject_Area?                      @relation(fields: [subject_area_id], references: [subject_area_id], onDelete: NoAction, onUpdate: NoAction)
  Subject_Category_Project         Subject_Category_Project[]
