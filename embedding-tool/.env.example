# PostgreSQL connection. Keep real credentials only in ignored .env files.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Default selection when --dimension is omitted.
EMBEDDING_DIMENSION=3072
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_NAME=qwen3-embedding:8b

# Dimension-specific providers/models used by run_pipeline.bat option V.
EMBEDDING_PROVIDER_768=local
EMBEDDING_MODEL_NAME_768=sentence-transformers/all-mpnet-base-v2

EMBEDDING_PROVIDER_3072=ollama
EMBEDDING_MODEL_NAME_3072=qwen3-embedding:8b
EMBEDDING_OLLAMA_HOST=http://localhost:11434

# Optional runtime tuning.
EMBEDDING_DEVICE=
EMBEDDING_NORMALIZE=false
EMBEDDING_DB_CONNECT_TIMEOUT=20
EMBEDDING_COMMIT_EVERY=100
EMBEDDING_BATCH_SIZE=16
EMBEDDING_LIMIT=0
